{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "profile": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "email": {
          "type": "string",
          "format": "email",
          "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
        },
        "location": {
          "type": "object",
          "properties": {
            "fr": {
              "type": "string"
            },
            "en": {
              "type": "string"
            }
          },
          "required": [
            "fr",
            "en"
          ],
          "additionalProperties": false
        },
        "eyebrow": {
          "type": "object",
          "properties": {
            "fr": {
              "type": "string"
            },
            "en": {
              "type": "string"
            }
          },
          "required": [
            "fr",
            "en"
          ],
          "additionalProperties": false
        },
        "bio": {
          "type": "object",
          "properties": {
            "fr": {
              "type": "string"
            },
            "en": {
              "type": "string"
            }
          },
          "required": [
            "fr",
            "en"
          ],
          "additionalProperties": false
        },
        "cvAsset": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^assets\\/[a-zA-Z0-9_./-]+$"
            },
            {
              "type": "string",
              "format": "uri"
            }
          ]
        }
      },
      "required": [
        "name",
        "email",
        "location",
        "eyebrow",
        "bio",
        "cvAsset"
      ],
      "additionalProperties": false
    },
    "highlights": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "icon": {
            "type": "string",
            "enum": [
              "code",
              "cash",
              "graduation",
              "certificate"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "fr": {
                    "type": "string"
                  },
                  "en": {
                    "type": "string"
                  }
                },
                "required": [
                  "fr",
                  "en"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "object",
            "properties": {
              "fr": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "en": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "fr",
              "en"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "icon",
          "value",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "skills": {
