# All VITE_* variables are public browser configuration. Never place secrets here.
# bundled: validates and reads src/features/portfolio/data/portfolio.json (default).
# http: fetches the same data contract from an API or CMS.
VITE_DATA_SOURCE=bundled
# Leave empty for same-origin requests. Example: https://api.example.com
VITE_API_BASE_URL=
VITE_PORTFOLIO_ENDPOINT=/examples/portfolio.json
# Optional canonical URL for your own deployment.
VITE_SITE_URL=
